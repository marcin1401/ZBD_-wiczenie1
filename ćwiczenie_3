
-- 1 Utwórz widok v_wysokie_pensje, dla tabeli employees, który pokaże wszystkich pracowników zarabiających więcej niż 6000. 

CREATE VIEW v_wysokie_pensje AS
SELECT *
FROM employees
WHERE salary > 6000;

