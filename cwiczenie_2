SELECT last_name || ' ' || salary AS wynagrodzenie
FROM employees
WHERE department_id IN (20, 50)
  AND salary BETWEEN 2000 AND 7000
ORDER BY last_name;

SELECT hire_date, last_name, manager_id
FROM employees
WHERE manager_id IS NOT NULL
  AND hire_date >= DATE '2005-01-01'
  AND hire_date < DATE '2006-01-01'
ORDER BY manager_id;

SELECT FIRST_NAME || ' ' || LAST_NAME AS IMIE_NAZWISKO,
       SALARY,
       PHONE_NUMBER
FROM EMPLOYEES
WHERE LAST_NAME LIKE '__e%'
  AND LOWER(FIRST_NAME) LIKE '%david%'
ORDER BY 1 DESC, 2 ASC;

SELECT FIRST_NAME || ' ' || LAST_NAME AS IMIE_NAZWISKO,
       ROUND(MONTHS_BETWEEN(SYSDATE, HIRE_DATE)) AS LICZBA_MIESIECY,
       CASE
           WHEN ROUND(MONTHS_BETWEEN(SYSDATE, HIRE_DATE)) < 150
               THEN SALARY * 0.10
           WHEN ROUND(MONTHS_BETWEEN(SYSDATE, HIRE_DATE)) <= 200
               THEN SALARY * 0.20
           ELSE SALARY * 0.30
       END AS WYSOKOSC_DODATKU
FROM EMPLOYEES
ORDER BY 2 ASC;

SELECT D.DEPARTMENT_NAME AS NAZWA_DZIALU,
       SUM(E.SALARY) AS SUMA_ZAROBKOW,
       ROUND(AVG(E.SALARY)) AS SREDNIA_ZAROBKOW
FROM DEPARTMENTS D
JOIN EMPLOYEES E
    ON D.DEPARTMENT_ID = E.DEPARTMENT_ID
GROUP BY D.DEPARTMENT_ID, D.DEPARTMENT_NAME
HAVING MIN(E.SALARY) > 5000;

SELECT E.LAST_NAME,
       E.DEPARTMENT_ID,
       D.DEPARTMENT_NAME,
       E.JOB_ID
FROM EMPLOYEES E
JOIN DEPARTMENTS D
    ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
JOIN LOCATIONS L
    ON D.LOCATION_ID = L.LOCATION_ID
WHERE L.CITY = 'Toronto';

SELECT E1.FIRST_NAME || ' ' || E1.LAST_NAME AS PRACOWNIK,
       E2.FIRST_NAME || ' ' || E2.LAST_NAME AS WSPOLPRACOWNIK
FROM EMPLOYEES E1
JOIN EMPLOYEES E2
    ON E1.DEPARTMENT_ID = E2.DEPARTMENT_ID
   AND E1.EMPLOYEE_ID <> E2.EMPLOYEE_ID
WHERE E1.FIRST_NAME = 'Jennifer';


SELECT D.DEPARTMENT_ID,
       D.DEPARTMENT_NAME
FROM DEPARTMENTS D
WHERE NOT EXISTS (
    SELECT 
    FROM EMPLOYEES E
    WHERE E.DEPARTMENT_ID = D.DEPARTMENT_ID
);

SELECT E.FIRST_NAME || ' ' || E.LAST_NAME AS IMIE_NAZWISKO,
       E.JOB_ID,
       D.DEPARTMENT_NAME,
       E.SALARY,
       G.GRADE
FROM EMPLOYEES E
LEFT JOIN DEPARTMENTS D
    ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
JOIN JOB_GRADES G
    ON E.SALARY BETWEEN G.MIN_SALARY AND G.MAX_SALARY
ORDER BY E.LAST_NAME;

SELECT FIRST_NAME, LAST_NAME, SALARY
FROM EMPLOYEES
WHERE SALARY > (
    SELECT AVG(SALARY)
    FROM EMPLOYEES
)
ORDER BY SALARY DESC;



SELECT E.EMPLOYEE_ID,
       E.FIRST_NAME,
       E.LAST_NAME,
       D.DEPARTMENT_NAME
FROM EMPLOYEES E
JOIN DEPARTMENTS D
    ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
WHERE E.DEPARTMENT_ID IN (
    SELECT DEPARTMENT_ID
    FROM EMPLOYEES
    WHERE LAST_NAME LIKE '%u%'
      AND DEPARTMENT_ID IS NOT NULL
)
ORDER BY D.DEPARTMENT_NAME;

SELECT EMPLOYEE_ID,
       FIRST_NAME,
       LAST_NAME
FROM EMPLOYEES
WHERE MONTHS_BETWEEN(SYSDATE, HIRE_DATE) > (
    SELECT AVG(MONTHS_BETWEEN(SYSDATE, HIRE_DATE))
    FROM EMPLOYEES
)
ORDER BY HIRE_DATE;







SELECT D.DEPARTMENT_NAME,
       COUNT(E.EMPLOYEE_ID),
       ROUND(AVG(E.SALARY), 2) 
FROM DEPARTMENTS D
INNER JOIN EMPLOYEES E
    ON D.DEPARTMENT_ID = E.DEPARTMENT_ID
GROUP BY D.DEPARTMENT_ID, D.DEPARTMENT_NAME
ORDER BY COUNT(E.EMPLOYEE_ID) DESC;

SELECT FIRST_NAME, LAST_NAME
FROM EMPLOYEES
WHERE SALARY < ALL (
    SELECT E.SALARY
    FROM EMPLOYEES E
    JOIN DEPARTMENTS D
        ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
    WHERE D.DEPARTMENT_NAME = 'IT'
);

SELECT DISTINCT D.DEPARTMENT_ID,
       D.DEPARTMENT_NAME
FROM DEPARTMENTS D
INNER JOIN EMPLOYEES E
    ON D.DEPARTMENT_ID = E.DEPARTMENT_ID
WHERE E.SALARY > (
    SELECT AVG(SALARY)
    FROM EMPLOYEES
)
ORDER BY D.DEPARTMENT_NAME;


SELECT J.JOB_TITLE,
       ROUND(AVG(E.SALARY), 2) 
FROM EMPLOYEES E
JOIN JOBS J
    ON E.JOB_ID = J.JOB_ID
GROUP BY J.JOB_ID, J.JOB_TITLE
ORDER BY AVG(E.SALARY) DESC
FETCH FIRST 5 ROWS ONLY;

SELECT R.REGION_NAME,
       COUNT(DISTINCT C.COUNTRY_ID),
       COUNT(DISTINCT E.EMPLOYEE_ID)
FROM REGIONS R
INNER JOIN COUNTRIES C ON R.REGION_ID = C.REGION_ID
INNER JOIN LOCATIONS L ON C.COUNTRY_ID = L.COUNTRY_ID
INNER JOIN DEPARTMENTS D ON L.LOCATION_ID = D.LOCATION_ID
INNER JOIN EMPLOYEES E ON D.DEPARTMENT_ID = E.DEPARTMENT_ID
GROUP BY R.REGION_NAME;

SELECT E.FIRST_NAME, E.LAST_NAME
FROM EMPLOYEES E
INNER JOIN EMPLOYEES M
    ON E.MANAGER_ID = M.EMPLOYEE_ID
WHERE E.SALARY > M.SALARY;

SELECT TO_CHAR(HIRE_DATE, 'MM') AS M,
       COUNT(*) 
FROM EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE, 'MM')
ORDER BY M;

SELECT D.DEPARTMENT_NAME,
       ROUND(AVG(E.SALARY), 2) 
FROM DEPARTMENTS D
JOIN EMPLOYEES E
    ON D.DEPARTMENT_ID = E.DEPARTMENT_ID
GROUP BY D.DEPARTMENT_NAME
ORDER BY AVG(E.SALARY) DESC
FETCH FIRST 3 ROWS ONL
