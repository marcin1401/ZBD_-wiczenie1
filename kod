CREATE TABLE REGIONS
 (
    region_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    region_name VARCHAR2(25) NOT NULL
);
CREATE TABLE COUNTRIES 
(
    country_id CHAR(2) PRIMARY KEY,
    country_name VARCHAR2(40) NOT NULL,
    region_id NUMBER NOT NULL,
    CONSTRAINT FK_COUNTRIES_REGIONS
        FOREIGN KEY (region_id)
        REFERENCES REGIONS(region_id)
);
CREATE TABLE LOCATIONS
(
    location_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    street_address VARCHAR2(30),
    postal_code VARCHAR2(20),
    city VARCHAR2(30),
    state_province VARCHAR2(30),
    country_id CHAR(2)
);

CREATE TABLE JOBS 
(
    job_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    job_title VARCHAR2(35) NOT NULL,
    min_salary NUMBER(10,2) NOT NULL,
    max_salary NUMBER(10,2) NOT NULL,
    CONSTRAINT CHECKK_JOBS_SALARY
        CHECK (max_salary >= min_salary + 2000)
);

CREATE TABLE DEPARTMENTS
 (
    department_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    department_name VARCHAR2(30) NOT NULL,
    manager_id NUMBER,
    location_id NUMBER NOT NULL
);
CREATE TABLE EMPLOYEES
 (
    employee_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    first_name VARCHAR2(20) NOT NULL,
    last_name VARCHAR2(25) NOT NULL,
    email VARCHAR2(50) NOT NULL,
    phone_number VARCHAR2(20),
    hire_date DATE NOT NULL,
    job_id NUMBER NOT NULL,
    salary NUMBER(10,2) NOT NULL,
    commission_pct NUMBER(4,2),
    manager_id NUMBER,
    department_id NUMBER NOT NULL
);

CREATE TABLE JOB_HISTORY
(
    employee_id NUMBER PRIMARY KEY,
    start_date DATE,
    end_date DATE,
    job_id NUMBER(20) NOT NULL,
    department_id NUMBER(20) NOT NULL,
    CONSTRAINT FK_JOB_HISTORY_DEPARTMENTS
        FOREIGN KEY (department_id)
        REFERENCES DEPARTMENTS(department_id),
    CONSTRAINT FK_JOB_HISTORY_JOBS
        FOREIGN KEY (job_id)
        REFERENCES JOBS(job_id)
);


ALTER TABLE LOCATIONS
ADD CONSTRAINT FK_LOCATIONS_COUNTRIES
FOREIGN KEY (country_id)
REFERENCES COUNTRIES(country_id);

ALTER TABLE DEPARTMENTS
ADD CONSTRAINT FK_DEPARTMENTS_LOCATIONS
FOREIGN KEY (location_id)
REFERENCES LOCATIONS(location_id);

ALTER TABLE EMPLOYEES
ADD CONSTRAINT FK_EMPLOYEES_JOBS
FOREIGN KEY (job_id)
REFERENCES JOBS(job_id);

ALTER TABLE EMPLOYEES
ADD CONSTRAINT FK_EMPLOYEES_DEPARTMENTS
FOREIGN KEY (department_id)
REFERENCES DEPARTMENTS(department_id);

ALTER TABLE EMPLOYEES
ADD CONSTRAINT FK_EMPLOYEES_MANAGER
FOREIGN KEY (manager_id)
REFERENCES EMPLOYEES(employee_id);


ALTER TABLE DEPARTMENTS
ADD CONSTRAINT FK_DEPARTMENTS_MANAGER
FOREIGN KEY (manager_id)
REFERENCES EMPLOYEES(employee_id);

ALTER TABLE JOB_HISTORY
ADD CONSTRAINT FK_JOB_HISTORY_EMPLOYEES
FOREIGN KEY (employee_id)
REFERENCES EMPLOYEES(employee_id);


